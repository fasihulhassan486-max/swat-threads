# Public WooCommerce Store API base URL (no consumer keys in frontend env).
VITE_WC_URL=https://api.virasstore.com

# Secure server-side endpoint that validates and submits WooCommerce orders.
# Never point this at /wp-json/wc/v3/orders or place WooCommerce keys in VITE_ variables.
VITE_ORDER_PROXY_URL=

# Analytics & Marketing Pixel IDs
VITE_GA4_ID=G-YOUR_ACTUAL_GA4_ID
VITE_META_PIXEL_ID=YOUR_ACTUAL_PIXEL_ID
